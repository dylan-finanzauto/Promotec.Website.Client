---
import PhoneIcon from "./icons/PhoneIcon.astro";
import WhatsappIcon from "./icons/WhatsappIcon.astro";
---

<div class="fixed right-0 top-1/2 -translate-y-1/2 mt-12">
  <div class="flex flex-col items-end gap-2">
    <div
      class="size-20 bg-tirth rounded-l-full grid place-items-center cursor-default transition-all duration-300 hover:w-24 shadow-lg hover:shadow-2xl"
    >
      <PhoneIcon class="text-white" />
    </div>
    <div
      class="size-20 bg-tirth rounded-l-full grid place-items-center cursor-default transition-all duration-300 hover:w-24 shadow-lg hover:shadow-2xl"
    >
      <WhatsappIcon class="text-white" />
    </div>
  </div>
</div>
