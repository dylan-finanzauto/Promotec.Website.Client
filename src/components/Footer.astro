---
import Wrapper from "@/layouts/Wrapper.astro";
import Logo from "./icons/Logo.astro";
---

<footer class="bg-secn-blue pt-[120px] pb-[100px]">
    <Wrapper>
        <div class="flex justify-between py-8">
            <Logo class="text-white w-[196px] h-[55px] -mt-8" />
            <div class="flex gap-[10px]">
                <button
                    class="h-10 w-[162px] text-white border border-white rounded-[10px] bg-transparent cursor-pointer"
                    >Soy cliente</button
                >
                <button
                    class="h-10 w-[162px] bg-tirth text-white rounded-[10px] cursor-pointer"
                    >Pagos en línea</button
                >
            </div>
        </div>
    </Wrapper>
</footer>
