---
import Wrapper from "@/layouts/Wrapper.astro";
---

<section class="bg-white2 py-[100px] relative">
    <Wrapper>
        <div
            class="w-4xl min-w-0 rounded-[30px] bg-secn-blue p-10 text-white flex flex-col gap-5 relative z-10"
        >
            <h3 class="text-[50px] mb-[10px] font-bold leading-none">
                Te asesoramos en la búsqueda de tu <span class="text-princ-blue"
                    >póliza de seguro ideal</span
                >
            </h3>
            <p class="font-medium text-xl">
                Entendemos tus necesidades; por eso te acompañamos con nuestro
                equipo especializado para ayudarte a encontrar la póliza de
                seguros individual o colectiva, que se adapte a tus necesidades.
            </p>
            <div class="flex justify-end">
                <button
                    class="bg-tirth text-xl py-3 px-4 text-white rounded-[10px] cursor-pointer"
                    >Ver productos</button
                >
            </div>
        </div>

        <img
            class="absolute bottom-0 right-0"
            src="/img/portrait-excited-family.png"
            alt=""
        />
    </Wrapper>
</section>
