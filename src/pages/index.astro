---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Navigation from "@/components/Navigation.astro";
import HeroSection from "@/components/_sections/HeroSection.astro";
import Attention from "@/components/Attention.astro";
import Cookies from "@/components/Cookies.astro";
import Quotes from "@/components/_sections/Quotes.astro";
import Benefits from "@/components/_sections/Benefits.astro";
import Experience from "@/components/_sections/Experience.astro";
import Clients from "@/components/_sections/Clients.astro";
import Insurance from "@/components/_sections/Insurance.astro";
import Consulting from "@/components/_sections/Consulting.astro";
import Certified from "@/components/_sections/Certified.astro";
import Footer from "@/components/Footer.astro";
---

<Layout title="Promotec | Personas">
  <div class="sticky inset-0 z-40">
    <Header />
    <Navigation />
  </div>

  <main>
    <HeroSection />
    <Quotes />
    <Benefits />
    <Experience />
    <Clients />
    <Insurance />
    <Consulting />
    <Certified />
  </main>

  <Footer />

  <Attention />

  <!-- <Cookies /> -->
</Layout>
